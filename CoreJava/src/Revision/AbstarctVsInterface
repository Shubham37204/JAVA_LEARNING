interface Animal {

    // ==================================================
    // INTERFACE VARIABLES
    // ==================================================

    // Automatically:
    // public static final

    public static final int LEGS = 4;

    // We can also write:

    int EYES = 2;

    // Java automatically treats it as:
    // public static final int EYES = 2;


    // ==================================================
    // ABSTRACT METHODS
    // ==================================================

    // Automatically public abstract

    void sound();

    public abstract void move();


    // ==================================================
    // DEFAULT METHOD
    // ==================================================

    default void eat() {
        System.out.println("Animal is eating");
    }


    // ==================================================
    // STATIC METHOD
    // ==================================================

    static void info() {
        System.out.println("Animal interface");
    }


    // ==================================================
    // PRIVATE METHOD
    // ==================================================

    private void helper() {
        System.out.println("Private helper");
    }


    default void useHelper() {
        helper();
    }


    // ==================================================
    // ❌ CONSTRUCTOR
    // ==================================================

    // Animal() {
    // }
    //
    // ❌ Interface cannot have constructor


    // ==================================================
    // ❌ INSTANCE VARIABLE
    // ==================================================

    // int age;
    //
    // ❌ This is NOT an instance variable.
    //
    // If written like this, Java automatically makes it:
    //
    // public static final int age;
}
class Dog implements Animal {

    // ==================================================
    // IMPLEMENT ABSTRACT METHODS
    // ==================================================

    @Override
    public void sound() {
        System.out.println("Dog → Bark");
    }

    @Override
    public void move() {
        System.out.println("Dog → Running");
    }
}
public class Main {

    public static void main(String[] args) {

        // Animal a = new Animal();
        // ❌ Interface cannot be instantiated


        Dog d = new Dog();


        // ==================================================
        // ABSTRACT METHODS
        // ==================================================

        d.sound();
        d.move();


        // ==================================================
        // DEFAULT METHOD
        // ==================================================

        d.eat();


        // ==================================================
        // STATIC VARIABLES
        // ==================================================

        System.out.println(Animal.LEGS);

        System.out.println(Animal.EYES);


        // This is also possible:

        System.out.println(Dog.LEGS);


        // But this is NOT recommended:

        System.out.println(d.LEGS);


        // ==================================================
        // STATIC METHOD
        // ==================================================

        Animal.info();


        // ==================================================
        // PRIVATE METHOD
        // ==================================================

        // Animal.helper();
        // ❌ Cannot access private method

        d.useHelper();     // ✅
    }
}
