abstract class Animal {

    // =========================
    // VARIABLES
    // =========================

    // Instance variables
    public String name = "Animal";

    protected int age = 10;

    String type = "Living Being";       // default

    private String secret = "Private Data";

    // Final instance variable
    final String species = "Animal";

    // Static variable
    public static int count = 0;


    // =========================
    // CONSTRUCTORS
    // =========================

    public Animal() {
        count++;
        System.out.println("Public Animal constructor");
    }

    protected Animal(int age) {
        this.age = age;
        count++;
    }

    Animal(String name, int age) {
        this.name = name;
        this.age = age;
        count++;
    }


    // =========================
    // CONCRETE METHODS
    // =========================

    public void eat() {
        System.out.println("Animal is eating");
    }

    protected void walk() {
        System.out.println("Animal is walking");
    }

    void sleep() {
        System.out.println("Animal is sleeping");
    }

    private void secretMethod() {
        System.out.println("Private animal method");
    }


    // =========================
    // ABSTRACT METHODS
    // =========================

    public abstract void sound();

    protected abstract void move();

    abstract void breathe();


    // =========================
    // STATIC METHOD
    // =========================

    public static void info() {
        System.out.println("Animal is a parent class");
        System.out.println("Number of animals: " + count);
    }


    // =========================
    // FINAL METHOD
    // =========================

    public final void sleepForever() {
        System.out.println("Final method");
    }
}


// =====================================================
// SUBCLASS
// =====================================================

class Dog extends Animal {

    Dog() {
        super();
    }

    @Override
    public void sound() {
        System.out.println("Dog says: Bark");
    }

    @Override
    protected void move() {
        System.out.println("Dog is running");
    }

    @Override
    void breathe() {
        System.out.println("Dog is breathing");
    }

    void showParentData() {

        System.out.println(name);       // public
        System.out.println(age);        // protected
        System.out.println(type);       // default

        // System.out.println(secret);  // ❌ private

        // Static variable
        System.out.println(count);
        System.out.println(Animal.count);
    }
}


// =====================================================
// MAIN
// =====================================================

public class Main {

    public static void main(String[] args) {

        Dog d1 = new Dog();
        Dog d2 = new Dog();

        // Static variable belongs to the CLASS,
        // not to individual objects

        System.out.println(Animal.count);
        System.out.println(Dog.count);

        Animal.info();

        d1.sound();
        d1.move();
        d1.breathe();

        d1.eat();
        d1.walk();
        d1.sleep();

        d1.sleepForever();

        d1.showParentData();
    }
}

